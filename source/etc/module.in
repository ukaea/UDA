#%Module1.0
##UDA @PROJECT_VERSION@ Modulefile
##

module-whatis   "Loads the UDA version @PROJECT_VERSION@ environment"

conflict            uda
conflict            idam

set                 UDA_DIR             @CMAKE_INSTALL_PREFIX@
set                 UDA_IDL_DIR         @CMAKE_INSTALL_PREFIX@
setenv              UDA_DIR             $UDA_DIR
setenv              UDA_HOST            @UDA_HOST@
setenv              UDA_PORT            @UDA_PORT@

prepend-path        PYTHONPATH          @UDA_INSTALL_FULL_PYTHONDIR@
prepend-path        LD_LIBRARY_PATH     @UDA_INSTALL_FULL_LIBDIR@
prepend-path        IDL_DLM_PATH        @UDA_INSTALL_FULL_IDL_DLM_DIR@
prepend-path        IDL_PATH            @UDA_INSTALL_FULL_IDL_PRO_DIR@
prepend-path        PKG_CONFIG_PATH     @UDA_INSTALL_FULL_PKGCONFIGDIR@
set-alias           uda                 @UDA_INSTALL_FULL_BINDIR@/uda_cli
