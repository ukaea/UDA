#!/bin/bash

#------------------------------------------------------------------------------------------------------
# Make sure the log and runtime directories exist: bash skips any command whose redirection target
# cannot be opened. Packaged SYSTEM installs create them through systemd-tmpfiles (uda.conf).

mkdir -p "@UDA_INSTALL_FULL_LOGDIR@" "@UDA_INSTALL_FULL_RUNDIR@" 2>/dev/null

#------------------------------------------------------------------------------------------------------
# Load core UDA configuration

source @UDA_INSTALL_FULL_CONFIGDIR@/udaserver.cfg >>@UDA_INSTALL_FULL_LOGDIR@/startup.log 2>&1

#------------------------------------------------------------------------------------------------------
# Load machine specific configuration if it exists

if [[ -z "$UDAHOSTNAME" && -n "$(which dnsdomainname)" ]]
then
    UDAHOSTNAME=$(dnsdomainname)
    if [[ -z "$UDAHOSTNAME" ]]
    then
        UDAHOSTNAME=$(dnsdomainname -a | cut -d'.' -f2-)
    fi
    if [[ -z "$UDAHOSTNAME" ]]
    then
        UDAHOSTNAME=$(hostname -f)
    fi
elif [[ -z "$UDAHOSTNAME" ]]
then
    UDAHOSTNAME=$(hostname -f)
fi

if [[ -e "@UDA_INSTALL_FULL_MACHINE_CONFIGDIR@/$UDAHOSTNAME.cfg" ]]
then
    source @UDA_INSTALL_FULL_MACHINE_CONFIGDIR@/$UDAHOSTNAME.cfg >>@UDA_INSTALL_FULL_LOGDIR@/startup.log 2>&1
fi

#------------------------------------------------------------------------------------------------------
# Load plugin configurations

for I in $(ls @UDA_INSTALL_FULL_PLUGIN_FRAGMENTDIR@/*.cfg 2>/dev/null)
do
    source $I >>@UDA_INSTALL_FULL_LOGDIR@/startup.log 2>&1
done

#------------------------------------------------------------------------------------------------------
# Run the Server Program

@UDA_INSTALL_FULL_BINDIR@/@PROJECT_NAME@_server >>@UDA_INSTALL_FULL_LOGDIR@/server.log 2>&1

exit $?
