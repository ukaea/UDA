###############################################################################
# xinetd setup to start UDA server
###############################################################################

service @USER@uda
{
    disable         = no
    flags           = IPv4 NOLIBWRAP KEEPALIVE NODELAY
    type            = UNLISTED
    protocol        = tcp
    port            = @UDA_SERVER_PORT@
    socket_type     = stream
    wait            = no
    user            = @USER@
    server          = @UDA_INSTALL_FULL_SERVER_SCRIPTDIR@/udaserver.sh
    #env             = UDAHOSTNAME=uda-external-jet

    instances       = 100
    per_source      = 30

    v6only          = no
    groups          = yes
    umask           = 002

    log_type        = FILE @UDA_INSTALL_FULL_LOGDIR@/xinetd.logfile
    log_on_success  += DURATION USERID
    log_on_failure  += USERID
}
