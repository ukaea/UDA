# pkg-config file for the Universal Data Access library
prefix=@UDA_PKGCONFIG_PREFIX@
exec_prefix=${prefix}
includedir=@UDA_PKGCONFIG_INCLUDEDIR@
libdir=@UDA_PKGCONFIG_LIBDIR@

Name: UDA
Description: The Universal Data Access library
URL: https://ukaea.github.io/UDA/
Version: @PROJECT_VERSION@
Cflags: -DFATCLIENT -I${includedir} -I${includedir}/c++
Libs: -L${libdir} -lfatuda_cpp
Requires: @UDA_PC_REQUIRES@
Requires.private: @UDA_PC_REQUIRES_PRIVATE@
Libs.private: @UDA_PC_LIBS_PRIVATE@
