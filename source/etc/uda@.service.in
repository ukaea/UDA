[Unit]
Description=@USER@-uda service

[Service]
ExecStart=@UDA_INSTALL_FULL_SERVER_SCRIPTDIR@/udaserver.sh
Type=exec
User=@USER@
#Group=yes
UMask=002
StandardInput=socket
LimitNOFILE=30

StandardOutput=file:@UDA_INSTALL_FULL_LOGDIR@/uda.logfile
StandardError=inherit
SuccessExitStatus=0
LogLevelMax=info
