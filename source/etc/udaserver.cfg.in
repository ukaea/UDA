#------------------------------------------------------------------------------------------------------
# Creates the Environment needed by the UDA Server.
#------------------------------------------------------------------------------------------------------

export UDA_ROOT=@CMAKE_INSTALL_PREFIX@

#------------------------------------------------------------------------------------------------------
# UDA Logging mode

export UDA_LOG=$UDA_ROOT/etc
export UDA_LOG_MODE=a
export UDA_LOG_LEVEL=ERROR  # Options: INFO, DEBUG, WARN, ERROR, ACCESS
export UDA_DEBUG_APPEND=a

#------------------------------------------------------------------------------------------------------
# UDA DUMP Program Locations

export UDA_DUMP_MDSPLUS=`which idl 2>/dev/null`
export UDA_DUMP_IDA=`which idadump 2>/dev/null`
export UDA_DUMP_NETCDF=`which /usr/bin/ncdump 2>/dev/null`
export UDA_DUMP_HDF5=`which h5dump 2>/dev/null`

#------------------------------------------------------------------------------------------------------
# UDA Server Host
#------------------------------------------------------------------------------------------------------

export UDA_HOST=@UDA_SERVER_HOST@
export UDA_PORT=@UDA_SERVER_PORT@

#------------------------------------------------------------------------------------------------------
# Plugin Registration + Structure Passing configuration

export UDA_PLUGIN_CONFIG=$UDA_ROOT/etc/plugins/udaPlugins.conf
export UDA_SARRAY_CONFIG=$UDA_ROOT/etc/udagenstruct.conf
export UDA_PLUGIN_DEBUG_SINGLEFILE=1

#------------------------------------------------------------------------------------------------------
# Setup required dynamic library paths

export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:$UDA_ROOT/lib:$UDA_ROOT/lib/plugins"
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:@EXTRA_LD_LIBRARY_PATHS@"
export DYLD_LIBRARY_PATH=$LD_LIBRARY_PATH

#------------------------------------------------------------------------------------------------------
# Permitted filepaths for the server to access formatted as a comma-delimited list
# by deafult all file access will be prohibited if this is set to empty or 
# the environment variable is unset. Use semi-colons (;) to deliminate multiple allowed paths
# set the path to "/" to allow everything to be accessed
export UDA_ALLOWED_PATHS=

#------------------------------------------------------------------------------------------------------
# Optional Linux Landlock policy (requires ENABLE_LANDLOCK=ON and kernel ABI >= 3).
# Colon-separated absolute paths; files and directories must already exist.
# Leave all three UNSET to disable. Any exported class enables enforcement;
# an empty value grants nothing. Read/read-write never imply execute permission.
# Directory grants include descendants; overlapping grants combine permissions.
# Configure runtime libraries, plugin configuration, certificates and data as needed.
# Every path must exist: drop /usr/lib64 and /lib64 if your distribution lacks them.
# The server itself runs "head" via /bin/sh to detect extensionless file formats (plus
# UDA_DUMP_NETCDF/UDA_DUMP_IDA if set), so those and the ELF loader need execute grants.
# UDA_WORK_DIR and UDA_PLUGIN_REDIRECT_DIR default to /tmp; point them at writable scratch.
# Example for x86-64 (check the loader path for your architecture):
# export UDA_LANDLOCK_READONLY_PATHS="$UDA_ROOT/etc:$UDA_ROOT/lib:/srv/uda/data:/usr/lib:/usr/lib64:/lib:/lib64:/etc/ld.so.cache"
# export UDA_LANDLOCK_READWRITE_PATHS="/var/tmp/uda"
# export UDA_PLUGIN_REDIRECT_DIR="/var/tmp/uda"
# export UDA_WORK_DIR="/var/tmp/uda"
# export UDA_LANDLOCK_EXECUTE_PATHS="/bin/sh:/usr/bin/head:/lib64/ld-linux-x86-64.so.2"
# Startup failures are written to etc/server.log. See docs/server_sandboxing.md.
