FROM rockylinux:8

ARG SSL_AUTH="ON"
ARG CAPNP="ON"
ARG CLIENT_ONLY="OFF"
ARG INSTALL_DIR="/usr"
ARG BUILD_CORES=4

SHELL ["/bin/bash", "-c"]

RUN dnf update -y && \
  dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm && \
  dnf group install -y "Development Tools" && \
  dnf install -y \
      cmake \
      boost-devel \
      openssl-devel \
      libxml2-devel \
      xz-devel \
      zlib-devel \
      libtirpc-devel \
      fmt fmt-devel \
      spdlog spdlog-devel \
      capnproto capnproto-devel \
      pkgconf-pkg-config \
      rpmlint

COPY . /uda

RUN cd /uda && \
    cmake -B build \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DSSLAUTHENTICATION="$SSL_AUTH" \
    -DCLIENT_ONLY="$CLIENT_ONLY" \
    -DENABLE_CAPNP="$CAPNP" \
    -DCMAKE_INSTALL_PREFIX="$INSTALL_DIR" \
    -DUDA_INSTALL_LAYOUT=SYSTEM

RUN cd /uda && cmake --build build -j "$BUILD_CORES" --config Release --target install

# Check the installed package in its system locations, using the same smoke tests as CI.
RUN GENERATOR="Unix Makefiles" /uda/scripts/ci/smoke-installed.sh "$INSTALL_DIR" /tmp/uda-cpp /uda/build
RUN cd /uda && cmake --build build --target package
RUN rpmlint -v /uda/build/*.rpm
